{
  "name": "mealkeeper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:recipe-assets && next build",
    "analyze": "node scripts/analyze.mjs",
    "check:pwa": "node scripts/pwa-smoke.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx prisma/seed.ts",
    "validate:recipe-assets": "node prisma/validate-recipe-assets.mjs",
    "db:migrate": "prisma migrate dev",
    "db:prepare-postgres": "node scripts/prepare-postgres.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.2.0",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "^14.2.15",
    "next-auth": "4.24.11",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "recharts": "^3.10.1",
    "web-push": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.15",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^10.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
